# Optional. The pipeline can create generic topic-anchored narration without an LLM key.
ANTHROPIC_API_KEY=        # LLM-written script + scene keywords
ANTHROPIC_MODEL=claude-sonnet-5-5
PEXELS_API_KEY=           # real stock footage per scene (free at pexels.com/api)
WIKIMEDIA_CONTACT=        # optional email or URL included in Wikimedia Commons requests
